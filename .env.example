# ==============================================================================
# DCC Pipeline AI Agent - Environment Configuration Template
# Copy this file to .env and configure for your local workstation and network:
# cp .env.example .env
# ==============================================================================

# 1. Unreal Engine 5.8 Native MCP Settings
UE_MCP_URL=http://127.0.0.1:8000/mcp
UE_TIMEOUT=15.0

# 2. Remote Ollama LLM Inference Node (Mac M5 Private Cluster / Remote Host)
OLLAMA_BASE_URL=http://192.168.1.222:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=gemma4:12b-mlx
OLLAMA_HEAVY_MODEL=qwen3.6:27b-mlx

# 3. Local RAG Knowledge Base & ChromaDB Settings
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=dcc_knowledge_hub

# 4. Agent Resilience & Self-Healing Guardrails
MAX_RETRIES=2

# 5. FastAPI Microservice Gateway Settings
API_HOST=127.0.0.1
API_PORT=8080
